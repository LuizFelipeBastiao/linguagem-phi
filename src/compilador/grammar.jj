}

TOKEN :
{
  < ID : ([ "a"-"z", "A"-"Z" ]) ([ "a"-"z", "A"-"Z", "0"-"9", "_" ])* >
| < INTEIRO : ([ "0"-"9" ])+ >
| < REAL : ([ "0"-"9" ])+ "." ([ "0"-"9" ])+ >
