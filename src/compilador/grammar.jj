void expressao() :
{}
{
  multiplicacao()
  (
    (
      < MAIS >
    | < MENOS >
    )
    multiplicacao()
  )*
}

void multiplicacao() :
{}
{
  fator()
  (
    (
      < MULTIPLICA >
    | < DIVIDE >
    )
    fator()
  )*
}

void fator() throws ParseException :
{
	  Token id;
}
{
  id = < ID >
